// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum  ProductStatus {
  AVAILABLE
  UNAVAILABLE
  DELETED
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  firstName   String   
  lastName    String
  password    String
  role        Role        @default(USER)
  number      String?     @unique
  profileImage String     @default("/fhdsgdfhljgkhdf")
  status      UserStatus  @default(ACTIVE)
  lastLogin   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  privilages  String[]    @default([])

  @@map("users")
}

model Product {
  id        String               @id @default(uuid())
  sku       String
  name      String
  altName   String[]             @default([])
  discription String?
  stock       Int                @default(0)
  status      ProductStatus     @default(UNAVAILABLE)
  price       Float  
  compareAt   Float?             
  model       String?           
  brand       String?

  media       Media[]

}

model Media {
  id      String        @id @default(uuid())
  type    MediaType     
  url     String

  productId   String
  product     Product   @relation(fields: [productId] , references: [id]) 
}
